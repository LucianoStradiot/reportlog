<mvc:View controllerName="com.claro.proveedores.reportsystemlog.controller.View1"
    xmlns:mvc="sap.ui.core.mvc" displayBlock="true"
	xmlns="sap.m"
	xmlns:fb="sap.ui.comp.filterbar"
	xmlns:core="sap.ui.core">
	<Page id="page" title="{i18n>title}">
		<headerContent>
			<Button tooltip="{i18n>actualizar}" icon="sap-icon://synchronize" press="onSetView"/>
		</headerContent>
		<content>
			<fb:FilterBar id="filterbar" persistencyKey="myPersKey" useToolbar="false" search=".onSearch" showFilterConfiguration="false" showGoOnFB="false">
				<fb:filterGroupItems>
					<fb:FilterGroupItem name="Rango de fecha" label="{i18n>rangoFecha}" groupName="Group1" visibleInFilterBar="true">
						<fb:control>
							<DateRangeSelection change="onSetView" displayFormat="dd/MM/yyyy" id="oDateRangeSelectionInitialId"></DateRangeSelection>
						</fb:control>
					</fb:FilterGroupItem>
					<fb:FilterGroupItem name="busqueda" label="{i18n>busqueda}" groupName="Group1" visibleInFilterBar="true">
						<fb:control>
							<SearchField search="onSearchTable" placeholder="{i18n>buscar}..."/>
						</fb:control>
					</fb:FilterGroupItem>
				</fb:filterGroupItems>
			</fb:FilterBar>
			<Table id="oTable" alternateRowColors="false" inset="false" items="{ path: 'oModel>/DATA/', sorter:[{path: 'CREATION_DATE', descending:true, group:false}]}" fixedLayout="false" showNoData="true" noDataText="{i18n>sinDatos}">
				<headerToolbar>
					<OverflowToolbar>
						<Title text="{oModel>/TITULO_TABLA}" level="H2"/>
						<Button tooltip="{i18n>descargaExcel}" icon="sap-icon://excel-attachment" press="onDescargaExcel" enabled="{modelSettings>/enabledButtonTable}"/>
						<ToolbarSpacer/>
						<Button tooltip="{i18n>ordenar}" icon="sap-icon://sort" press="handleSortButtonPressed" enabled="{modelSettings>/enabledButtonTable}"/>
						<Button tooltip="{i18n>filtrar}" icon="sap-icon://add-filter" press="handleFilterButtonPressed" enabled="{modelSettings>/enabledButtonTable}"/>
					</OverflowToolbar>
				</headerToolbar>
				<columns>
					<Column minScreenWidth="Tablet" demandPopin="true" hAlign="Left">
						<Text text="{i18n>description}"/>
					</Column>
					<Column minScreenWidth="Tablet" demandPopin="true" hAlign="Left" width="7rem">
						<Text text="{i18n>origen}"/>
					</Column>
					<Column minScreenWidth="Tablet" demandPopin="true" hAlign="Left" width="7rem">
						<Text text="{i18n>accion}"/>
					</Column>
					<Column minScreenWidth="Tablet" demandPopin="true" hAlign="Left">
						<Text text="{i18n>usuario}"/>
					</Column>
					<Column hAlign="Center" minScreenWidth="Tablet" demandPopin="true">
						<Text text="{i18n>fecha}"/>
					</Column>
					<Column minScreenWidth="Tablet" demandPopin="true" hAlign="Left">
						<Text text="{i18n>app}"/>
					</Column>
					<Column hAlign="Center" width="8rem" minScreenWidth="Tablet" demandPopin="true">
						<Text text="{i18n>detalle}"/>
					</Column>
				</columns>
				<items>
					<ColumnListItem vAlign="Middle">
						<cells>
							<Text text="{oModel>DESCRIPTION}"/>
							<Text text="{oModel>LOCATION}"/>
							<Text text="{oModel>ACTION}"/>
							<Text text="{oModel>CREATION_USER}"/>
							<Text text="{oModel>OBJ_DATE_STRING}"/>
							<Text text="{oModel>APP_DESCRIPTION}"/>
							<Button icon="sap-icon://show" press="onDialogModify" text="Ver más" iconFirst="true"></Button>
						</cells>
					</ColumnListItem>
				</items>
			</Table>
		</content>
	</Page>
</mvc:View>