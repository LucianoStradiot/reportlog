<core:FragmentDefinition xmlns="sap.m"
	xmlns:core="sap.ui.core">
	<ViewSettingsDialog confirm="handleSortDialogConfirm" sortDescending="true" resetFilters="onResetSort">
		<sortItems>
			<ViewSettingsItem text="{i18n>description}" key="DESCRIPTION"/>
			<ViewSettingsItem text="{i18n>origen}" key="LOCATION"/>
			<ViewSettingsItem text="{i18n>accion}" key="ACTION"/>
			<ViewSettingsItem text="{i18n>usuario}" key="CREATION_USER"/>
			<ViewSettingsItem text="{i18n>fecha}" selected="true" key="CREATION_DATE"/>
			<ViewSettingsItem text="{i18n>app}" key="APP_DESCRIPTION"/>
		</sortItems>
	</ViewSettingsDialog>
</core:FragmentDefinition>